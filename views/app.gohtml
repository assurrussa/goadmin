<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {{ if .hotServerUrl }}
    {{/* Vite dev server - используем относительные пути через Traefik */}}
    <script type="module" src="/@vite/client"></script>
    <script type="module" src="/src/js/app.ts"></script>
    <link rel="icon" type="image/x-icon" href="/src/images/favicon.ico">
    {{ else }}
    {{/* Production - используем скомпилированные файлы */}}
    <link href="{{ asset "css/app.css" }}" rel="stylesheet">
    <script type="module" src="{{ asset "js/app.js" }}"></script>
    <link rel="icon" type="image/x-icon" href="{{ asset "favicon.ico" }}">
    {{ end }}
    
    <script>
        (function() {
            try {
                const page = {{ marshal .page }};
                const props = page && page.props || {};
                const authenticated = props.authuser && (props.authuser.idExact || props.authuser.id);
                let choice = { theme: 'system', locale: 'ru', density: 'default' };
                if (authenticated) {
                    const personal = props.appearance;
                    if (personal && String(personal.owner) === String(authenticated) && personal.payload) choice = personal.payload;
                } else {
                    try { choice = JSON.parse(localStorage.getItem('goadmin.appearance.device.v1')) || choice; } catch (_) {}
                }
                const savedTheme = ['system', 'light', 'dark'].includes(choice.theme) ? choice.theme : 'system';
                document.documentElement.setAttribute('data-theme-preference', savedTheme);
                document.documentElement.setAttribute('data-appearance-owner', authenticated ? String(authenticated) : '');
                const systemDarkMode = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                const shouldBeDark = savedTheme === 'dark' || (savedTheme === 'system' && systemDarkMode);
                document.documentElement.lang = choice.locale === 'en' ? 'en' : 'ru';
                document.documentElement.setAttribute('data-density', ['default', 'compact', 'comfortable'].includes(choice.density) ? choice.density : 'default');
                
                if (shouldBeDark) {
                    document.documentElement.classList.add('dark');
                    document.documentElement.setAttribute('data-theme-mode', 'dark');
                } else {
                    document.documentElement.classList.remove('dark');
                    document.documentElement.setAttribute('data-theme-mode', 'light');
                }
            } catch (error) {
                console.warn('Error in theme script:', error);
            }
        })();
    </script>
</head>
<body>
<div id="app" data-page="{{ marshal .page }}"></div>
</body>
</html>
