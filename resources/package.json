{
  "name": "frontadmin",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "admin:paths": "node scripts/generate-tsconfig-paths.cjs",
    "dev": "npm run admin:paths && vite",
    "build": "run-s test:manifest test:unit type-check format lint build-only",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:manifest": "node --test scripts/*.test.cjs",
    "build-only": "npm run admin:paths && vite build && node scripts/verify-client-assets.cjs",
    "type-check": "npm run admin:paths && vue-tsc --build && npm run test:host-types",
    "test:host-types": "node scripts/check-typed-host.cjs",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.29",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "1.5.6",
    "@vitest/eslint-plugin": "^1.6.24",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.8.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite-plugin-vue-devtools": "^7.7.6",
    "vitest": "4.1.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@inertiajs/vue3": "^2.3.27",
    "@tailwindcss/postcss": "^4.1.8",
    "@tailwindcss/vite": "^4.1.8",
    "@tiptap/extension-character-count": "3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extension-horizontal-rule": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list-item": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-table-cell": "3.32.0",
    "@tiptap/extension-table-header": "3.32.0",
    "@tiptap/extension-table-row": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/vue-3": "3.32.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vueuse/core": "^14.1.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cropperjs": "^1.6.2",
    "lucide-vue-next": "^0.563.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.2",
    "postcss": "^8.5.4",
    "qrcode": "1.5.4",
    "reka-ui": "^2.8.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.8",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
