# The published library supplies its own embedded UI. No sibling source contexts.
FROM golang:1.27.1-alpine AS build
ARG GOADMIN_VERSION
WORKDIR /src/starter
COPY examples/starter/ ./
RUN test -n "$GOADMIN_VERSION" && \
    for module in goadmin goauth gonotify gouploads gowebsocket; do \
      go mod edit -dropreplace=github.com/assurrussa/$module; \
    done && \
    go mod edit -require=github.com/assurrussa/goadmin@$GOADMIN_VERSION && \
    GOAUTH=off GOPRIVATE= GONOPROXY= GONOSUMDB= GOPROXY=https://proxy.golang.org \
    GOSUMDB=sum.golang.org GOVCS='*:off' GOWORK=off go build -mod=mod -o /tmp/goadmin-starter .

FROM alpine:3.22
RUN addgroup -S app && adduser -S -G app app && mkdir -p /data/uploads && chown -R app:app /data
COPY --from=build /tmp/goadmin-starter /usr/local/bin/goadmin-starter
USER app
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/goadmin-starter"]
