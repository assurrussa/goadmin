# Copy to .env, set the required secrets, then run: docker compose up --build
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
ADMIN_URL=http://localhost:8080
# Optional host ports; keep ADMIN_URL's port aligned with STARTER_ADMIN_PORT.
STARTER_ADMIN_PORT=8080
STARTER_MAILPIT_PORT=8025
CSRF_SECRET=
FIRST_ADMIN_SETUP_TOKEN=
GOAUTH_SIGNING_KEY=
GOAUTH_TOKEN_KEY=
GOAUTH_ENVELOPE_KEY=
# Optional: ADMIN_MODULES=access,jobs,uploads,queues,notifications,realtime,authmail
ADMIN_MODULES=
APP_ADMIN_CANONICAL_SESSION_BACKEND=pgsql
# Enable Compose profile authmail when selecting the authmail module.
SMTP_FROM=
# Required when selecting notifications; remote NotifyHub URLs must use HTTPS.
NOTIFYHUB_URL=
NOTIFYHUB_PROJECT_KEY=
