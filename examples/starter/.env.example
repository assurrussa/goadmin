# Copy to .env and set the required secrets. Run from examples/starter.
# Current checkout: bash ../../scripts/starter-local.sh up --build (see README.md).
# Published build: use the matching tag checkout and set GOADMIN_VERSION explicitly.
GOADMIN_VERSION=v0.30.0
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
ADMIN_URL=http://localhost:8080
# Optional host ports; keep ADMIN_URL's port aligned with STARTER_ADMIN_PORT.
STARTER_ADMIN_PORT=8080
CSRF_SECRET=
FIRST_ADMIN_SETUP_TOKEN=
GOAUTH_SIGNING_KEY=
GOAUTH_TOKEN_KEY=
GOAUTH_ENVELOPE_KEY=
# Empty means core only. For the first CRUD tutorial: ADMIN_MODULES=products
# Other modules are opt-in; see README.md before selecting dependencies.
ADMIN_MODULES=
# Optional for product-events-mcp. This peer must overwrite X-Real-IP with the client address.
MCP_PAIRING_TRUSTED_PROXY_IP=
APP_ADMIN_CANONICAL_SESSION_BACKEND=pgsql
# Required when selecting authmail; configure this sender in your NotifyHub project.
AUTH_MAIL_FROM=
# Required when selecting notifications or authmail; remote URLs must use HTTPS.
NOTIFYHUB_URL=
NOTIFYHUB_PROJECT_KEY=
